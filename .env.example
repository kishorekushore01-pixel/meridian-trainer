# Copy to .env and restart `npm run dev`. All options are free.
# Option A: Google Gemini free tier (get a key at https://aistudio.google.com/apikey)
VITE_AI_PROVIDER=gemini
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-flash-latest

# Option B: local Ollama, no key, works offline (install Ollama, then: ollama pull llama3.2)
# VITE_AI_PROVIDER=ollama
# VITE_OLLAMA_URL=http://localhost:11434
# VITE_OLLAMA_MODEL=llama3.2

# Option C: deployed site with server-side key (see api/chat.js). Set GEMINI_API_KEY on the host.
# VITE_AI_PROVIDER=proxy
# VITE_PROXY_URL=/api/chat

# VITE_AI_PROVIDER=none   -> rule-based helper only
